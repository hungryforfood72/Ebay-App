# Supabase Postgres connection string. In Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Transaction" pooler connection (port 6543) for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection, used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Cloudinary: Dashboard -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# UPC lookup: not required yet. src/lib/upcLookup.ts uses UPCitemdb's keyless
# trial endpoint (100 lookups/day). Add a paid key here later if needed.
UPC_LOOKUP_API_KEY=""

# Claude API key from console.anthropic.com (separate login from claude.ai).
# Used to draft eBay titles/descriptions from the UPC lookup + product photo.
ANTHROPIC_API_KEY=""

# Shared password gate for the whole site (src/proxy.ts). Pick anything,
# just needs to match what you set in Vercel's env vars too.
SITE_PASSWORD=""

# eBay Business Policy names (Seller Hub -> Account -> Business Policies).
# Must match exactly, including capitalization — used in the CSV export's
# ShippingProfileName/ReturnProfileName/PaymentProfileName columns instead
# of trying to fill in the individual shipping/return enum fields by hand.
# Everything ships free for now, so only one shipping policy is needed.
EBAY_SHIPPING_POLICY_FREE=""
EBAY_RETURN_POLICY_NAME=""
EBAY_PAYMENT_POLICY_NAME=""

# ZIP code the CSV's Location column uses (item ships from).
EBAY_LISTING_ZIP="60620"
