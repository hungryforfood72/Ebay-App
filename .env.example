# Supabase Postgres connection string. In Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Transaction" pooler connection (port 6543) for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection, used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Cloudinary: Dashboard -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# UPC lookup: not required yet. src/lib/upcLookup.ts uses UPCitemdb's keyless
# trial endpoint (100 lookups/day). Add a paid key here later if needed.
UPC_LOOKUP_API_KEY=""

# Claude API key from console.anthropic.com (separate login from claude.ai).
# Used to draft eBay titles/descriptions from the UPC lookup + product photo.
ANTHROPIC_API_KEY=""

# Shared password gate for the whole site (src/proxy.ts). Pick anything,
# just needs to match what you set in Vercel's env vars too.
SITE_PASSWORD=""

# eBay Business Policy names (Seller Hub -> Account -> Business Policies).
# Must match exactly, including capitalization — used in the CSV export's
# ShippingProfileName/ReturnProfileName/PaymentProfileName columns instead
# of trying to fill in the individual shipping/return enum fields by hand.
# Everything ships free for now, so only one shipping policy is needed.
EBAY_SHIPPING_POLICY_FREE=""
EBAY_RETURN_POLICY_NAME=""
EBAY_PAYMENT_POLICY_NAME=""

# ZIP code the CSV's Location column uses (item ships from).
EBAY_LISTING_ZIP="60620"

# --- Real eBay API (Inventory/Sell APIs) — separate from the CSV vars above ---
# Which keyset/environment the app talks to. Flipping this requires a
# redeploy (Vercel bakes env vars into the build) but both sets of
# credentials below can coexist, so nothing is lost by switching back.
EBAY_ENV="sandbox" # "sandbox" | "production"

# eBay Developer Portal -> your app's Sandbox keys. REDIRECT_URI is the
# RuName generated when you set the OAuth "accepted URL" to
# https://<your-domain>/api/ebay/callback on the Sandbox keyset's User
# Tokens page (it's a name eBay gives that redirect config, not the URL
# itself). MERCHANT_LOCATION_KEY is any string you choose (e.g.
# "warehouse-1") — see scripts/ebay-setup-location.ts, run once after
# connecting. The three POLICY_ID vars are numeric IDs from Seller Hub ->
# Account -> Business Policies — different from the *_POLICY_NAME vars
# above, which only power the legacy CSV export.
EBAY_SANDBOX_CLIENT_ID=""
EBAY_SANDBOX_CLIENT_SECRET=""
EBAY_SANDBOX_REDIRECT_URI=""
EBAY_SANDBOX_MERCHANT_LOCATION_KEY=""
EBAY_SANDBOX_FULFILLMENT_POLICY_ID=""
EBAY_SANDBOX_PAYMENT_POLICY_ID=""
EBAY_SANDBOX_RETURN_POLICY_ID=""

# Same set, but for the Production keyset — only needed once you're ready
# to flip EBAY_ENV to "production".
EBAY_PRODUCTION_CLIENT_ID=""
EBAY_PRODUCTION_CLIENT_SECRET=""
EBAY_PRODUCTION_REDIRECT_URI=""
EBAY_PRODUCTION_MERCHANT_LOCATION_KEY=""
EBAY_PRODUCTION_FULFILLMENT_POLICY_ID=""
EBAY_PRODUCTION_PAYMENT_POLICY_ID=""
EBAY_PRODUCTION_RETURN_POLICY_ID=""

# Promoted Listings ad campaign id — one ongoing campaign per environment,
# created once by scripts/ebay-setup-campaign.ts (run after reconnecting
# eBay with the sell.marketing scope granted), not per item.
EBAY_SANDBOX_AD_CAMPAIGN_ID=""
EBAY_PRODUCTION_AD_CAMPAIGN_ID=""

# Auth for the Vercel Cron job that syncs sold orders (vercel.json). Vercel
# automatically sends this as `Authorization: Bearer $CRON_SECRET` on
# requests it triggers — pick any random string, just needs to match
# between here and Vercel's env vars.
CRON_SECRET=""
