# Supabase Postgres connection string. In Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Transaction" pooler connection (port 6543) for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection, used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Cloudinary: Dashboard -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# UPC lookup (upcitemdb.com trial or paid key)
UPC_LOOKUP_API_KEY=""

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=""
