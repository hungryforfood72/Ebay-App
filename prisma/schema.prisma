// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  pending_review
  ready
  exported
}

enum ItemCondition {
  new
  new_other
  used
  for_parts
}

model ScanSession {
  id        String    @id @default(uuid())
  label     String?
  startedBy String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  items Item[]
}

model Item {
  id     String @id @default(uuid())
  sku    String @unique @default(uuid())
  status ItemStatus @default(pending_review)

  // Scan step
  upc            String
  quantity       Int
  isMultipack    Boolean  @default(false)
  packSize       Int?
  expirationDate DateTime?
  shelfLocation  String
  photoUrls      String[] @default([])
  scannedBy      String?

  scanSession   ScanSession? @relation(fields: [scanSessionId], references: [id])
  scanSessionId String?

  // Review step
  upcLookupData   Json?
  aiTitle         String?
  aiDescription   String?
  finalTitle      String?
  finalDescription String?
  price           Decimal?  @db.Decimal(10, 2)
  categoryId      String?
  condition       ItemCondition?
  compNotes       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  itemSpecifics   Json?     // AI-suggested key/value pairs: Color, Size, Brand, etc.

  // Shipping. Unchecked = free flat-rate shipping. Checked = calculated
  // (USPS Ground Advantage), cost varies by buyer location based on
  // weight + box size. Alaska/Hawaii are always excluded (store policy).
  chargeForShipping Boolean @default(false)
  boxSize           String?
  weightLbs         Int?
  weightOz          Int?

  // Export step
  exportBatch   ExportBatch? @relation(fields: [exportBatchId], references: [id])
  exportBatchId String?
  exportedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scanSessionId])
}

model ExportBatch {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  exportedBy String?

  items Item[]
}

// Keyword -> eBay category ID, so a category only has to be looked up once
// per product type. Matched against an item's title as a case-insensitive
// substring on the review page.
model CategoryRule {
  id           String   @id @default(uuid())
  keyword      String   @unique
  categoryId   String
  categoryName String
  createdAt    DateTime @default(now())
}

// eBay's full category tree, imported from their own official category
// changes export (not scraped, not AI-guessed). Used for instant local
// category search before ever falling back to an AI web search.
model EbayCategory {
  id   String @id // eBay's own category ID, used as-is
  name String // leaf category name, e.g. "Stickers"
  path String // full breadcrumb, e.g. "Crafts > ... > Stickers"

  @@index([name])
}
