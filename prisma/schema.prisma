// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  pending_review
  ready
  exported
  // "listed" = published live via the eBay Inventory API — distinct from
  // "exported", which only means a File Exchange CSV was generated, not
  // that eBay ever confirmed receiving it.
  listed
  // "sold" = soldQuantity has reached the item's full listed quantity. A
  // partially-sold multi-unit item stays "listed" — see soldQuantity below.
  sold
}

enum ItemCondition {
  new
  new_other
  used
  for_parts
}

model ScanSession {
  id        String    @id @default(uuid())
  label     String?
  startedBy String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  items Item[]
}

model Item {
  id     String     @id @default(uuid())
  sku    String     @unique @default(uuid())
  status ItemStatus @default(pending_review)

  // Scan step
  upc            String? // null for bundles — no single UPC applies
  quantity       Int // for bundles: how many complete bundles are available
  isMultipack    Boolean   @default(false)
  packSize       Int?
  expirationDate DateTime?
  shelfLocation  String
  photoUrls      String[]  @default([]) // photoUrls[0] is the bundle's "everything together" hero photo when isBundle
  scannedBy      String?

  // Bundle mode — eBay doesn't allow "mystery box" listings, so every item
  // inside a bundle has to be individually disclosed. Each entry:
  // { upc, quantity (per bundle), photoUrl, name, upcLookupData }.
  isBundle         Boolean @default(false)
  bundleComponents Json?

  scanSession   ScanSession? @relation(fields: [scanSessionId], references: [id])
  scanSessionId String?

  // Review step
  upcLookupData    Json?
  aiTitle          String?
  aiDescription    String?
  finalTitle       String?
  finalDescription String?
  price            Decimal?       @db.Decimal(10, 2)
  categoryId       String?
  condition        ItemCondition?
  compNotes        String?
  reviewedBy       String?
  reviewedAt       DateTime?
  itemSpecifics    Json? // AI-suggested key/value pairs: Color, Size, Brand, etc.

  // Shipping. Unchecked = free flat-rate shipping. Checked = calculated
  // (USPS Ground Advantage), cost varies by buyer location based on
  // weight + box size. Alaska/Hawaii are always excluded (store policy).
  chargeForShipping Boolean @default(false)
  boxSize           String?
  weightLbs         Int?
  weightOz          Int?

  // Export step
  exportBatch   ExportBatch? @relation(fields: [exportBatchId], references: [id])
  exportBatchId String?
  exportedAt    DateTime?

  // Manifest reconciliation — which shipment/load this was scanned in
  // from, if any (null for items scanned outside manifest mode).
  manifest   Manifest? @relation(fields: [manifestId], references: [id])
  manifestId String?

  // eBay API publish result — set by POST /api/items/[id]/publish-to-ebay,
  // never by the client. ebayOfferId is persisted as soon as createOffer
  // succeeds (before publishOffer runs) so a retry after a publish failure
  // can skip straight to publishing the existing offer instead of trying to
  // create a second one for the same SKU, which eBay rejects.
  ebayOfferId      String?
  ebayListingId    String?
  ebayPublishedAt  DateTime?
  ebayPublishError String?
  // "sandbox" | "production" this item was actually published to — kept
  // per-item so a listing link still resolves correctly even if EBAY_ENV
  // is later flipped to the other environment.
  ebayEnvironment  String?

  // Persisted eBay Inventory API SKU (toEbaySku(sku)), set once alongside
  // ebayOfferId. toEbaySku() is lossy/non-reversible (strips punctuation,
  // can truncate), so an incoming order's line-item SKU has to match
  // against this stored value via an indexed exact lookup rather than get
  // reverse-engineered or recomputed-and-compared against every Item.
  ebaySku String? @unique

  // Cumulative units sold via matched eBay orders and their accumulated
  // revenue/fees — updated transactionally alongside each new EbayItemSale
  // row, not recomputed by summing on every read. status only flips to
  // "sold" once soldQuantity reaches quantity (the item's full listed
  // amount); a partially-sold multi-unit item stays "listed" with
  // soldQuantity > 0, which is why these are separate fields rather than a
  // single before/after status flag.
  soldQuantity     Int     @default(0)
  soldRevenueTotal Decimal @default(0) @db.Decimal(10, 2)
  soldFeesTotal    Decimal @default(0) @db.Decimal(10, 2)

  sales EbayItemSale[]

  // eBay Promoted Listings ad state — set by /api/items/[id]/promote,
  // never by the client. One campaign is shared across every item in an
  // environment (see scripts/ebay-setup-campaign.ts and the
  // *_AD_CAMPAIGN_ID env vars), so no per-item campaign id is stored here.
  ebayAdId              String?
  promotedBidPercentage Int?
  promotedAt            DateTime?
  ebayPromoteError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scanSessionId])
  @@index([manifestId])
}

// One row per matched eBay order line item — not folded into Item directly
// because one Item (quantity > 1) can sell out across several separate
// orders over time. ebayOrderLineItemId is the sync job's idempotency
// checkpoint: a repeated cron run skips any line item already recorded
// here, the same non-clobbering philosophy as Item.ebayOfferId.
model EbayItemSale {
  id                  String   @id @default(uuid())
  item                Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId              String
  ebayOrderId         String
  ebayOrderLineItemId String   @unique
  quantity            Int
  revenue             Decimal  @db.Decimal(10, 2) // buyer-paid total for this line item
  fees                Decimal  @db.Decimal(10, 2) // summed from the Finances API; includes eBay's shipping-label deductions
  soldAt              DateTime
  createdAt           DateTime @default(now())

  @@index([itemId])
}

// Incremental order-sync watermark, one row per environment (mirrors
// EbayAuthToken's per-environment keying — kept separate since it's sync
// bookkeeping, not auth state).
model EbaySyncState {
  environment     String    @id // "sandbox" | "production"
  lastOrderSyncAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model ExportBatch {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  exportedBy String?

  items Item[]
}

// Keyword -> eBay category ID, so a category only has to be looked up once
// per product type. Matched against an item's title as a case-insensitive
// substring on the review page.
model CategoryRule {
  id           String   @id @default(uuid())
  keyword      String   @unique
  categoryId   String
  categoryName String
  createdAt    DateTime @default(now())
}

// eBay's full category tree, imported from their own official category
// changes export (not scraped, not AI-guessed). Used for instant local
// category search before ever falling back to an AI web search.
model EbayCategory {
  id   String @id // eBay's own category ID, used as-is
  name String // leaf category name, e.g. "Stickers"
  path String // full breadcrumb, e.g. "Crafts > ... > Stickers"

  @@index([name])
}

// Managed list of box sizes, editable on the Settings page, shown as a
// dropdown on the review page instead of free text.
model BoxSize {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now())
}

// Managed list of shelf locations, editable on the Settings page, shown as
// a dropdown on the scan page instead of free text.
model ShelfLocation {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now())
}

enum ManifestSupplier {
  bstock
  liquidation_com
  unknown
}

// One uploaded shipment/load manifest — the source of truth for what was
// supposed to arrive, so scanning against it can show what's actually been
// accounted for vs. expected. Items scanned in manifest mode still go
// through the normal review queue exactly like any other item; the
// manifest link is purely for reconciliation.
model Manifest {
  id              String           @id @default(uuid())
  title           String
  supplier        ManifestSupplier @default(unknown)
  totalLandedCost Decimal?         @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  createdBy       String?

  lines   ManifestLine[]
  damaged ManifestDamagedEntry[]
  items   Item[]
}

// One expected line from the manifest CSV — what the supplier says should
// have arrived. retailPrice/extendedRetail come straight from the CSV
// (not recomputed), so they double as a checksum against the file itself.
model ManifestLine {
  id               String   @id @default(uuid())
  manifest         Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId       String
  supplierSku      String? // e.g. BStock's "Item #" — Liquidation.com has none
  upc              String?
  description      String
  expectedQuantity Int
  retailPrice      Decimal  @db.Decimal(10, 2)
  extendedRetail   Decimal  @db.Decimal(10, 2)
  condition        String? // e.g. BStock's USED_GOOD/LIKE_NEW — Liquidation.com has none
  category         String?
  subcategory      String?
  // Original row order in the CSV — when the same UPC appears on more than
  // one line (e.g. split across pallets/lots), received/damaged units are
  // allocated to lines in this order, filling one before spilling to the
  // next, rather than crediting the same total to every matching line.
  sortOrder        Int      @default(0)

  @@index([manifestId, upc])
}

// A tally of units found damaged/expired while sorting a manifest — not a
// listing, just a count against the manifest's reconciliation, recorded via
// the "Scan as Damaged/Expired" flow instead of the normal item flow.
model ManifestDamagedEntry {
  id         String   @id @default(uuid())
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId String
  upc        String
  quantity   Int
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([manifestId, upc])
}

// eBay OAuth user token, one row per environment (sandbox/production) —
// single-tenant app, one eBay seller account, so environment alone is
// enough to key it. Keeping sandbox and production as separate rows lets
// EBAY_ENV flip between them without losing either connection. Refresh
// tokens are long-lived (~18mo) and aren't rotated on refresh, so only
// accessToken/accessTokenExpiresAt change after the initial connect.
model EbayAuthToken {
  environment           String   @id // "sandbox" | "production"
  accessToken           String
  accessTokenExpiresAt  DateTime
  refreshToken          String
  refreshTokenExpiresAt DateTime
  // Space-delimited scopes actually granted, as returned by eBay's token
  // endpoint. Null on a row issued before this field existed — treated as
  // "sell.inventory only" (its original grant) by getValidAccessToken's
  // refresh, and as "missing every newer scope" by getMissingScopes, which
  // is exactly correct: that row needs reconnecting before order sync
  // works.
  scope                 String?
  updatedAt             DateTime @updatedAt
}
