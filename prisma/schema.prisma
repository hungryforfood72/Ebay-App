// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  pending_review
  ready
  exported
  // "listed" = published live via the eBay Inventory API — distinct from
  // "exported", which only means a File Exchange CSV was generated, not
  // that eBay ever confirmed receiving it.
  listed
  // "sold" = soldQuantity has reached the item's full listed quantity. A
  // partially-sold multi-unit item stays "listed" — see soldQuantity below.
  sold
  // "expired" = the daily expiration sweep (src/lib/expireListings.ts)
  // successfully ended this listing on eBay because its expirationDate
  // passed. Only ever set once the eBay-side removal actually succeeded —
  // never flipped speculatively, since that would tell staff to pull
  // physical stock for something eBay might still show as buyable. See
  // Item.ebayEndError for the "tried and failed" case, which leaves
  // status untouched instead.
  expired
}

enum ItemCondition {
  new
  new_other
  used
  for_parts
}

enum UserRole {
  owner
  employee
}

// Real per-user accounts, replacing the old single shared SITE_PASSWORD
// gate — Cristian wanted to know who made a given change (stock
// adjustments, scans, etc.) and to limit what employees can see/do (no
// financial numbers, can't delete records, no Settings access), neither
// of which a single shared password could ever support. passwordSalt is
// stored separately from passwordHash (not concatenated into one string)
// so the hashing scheme is legible at a glance rather than needing to
// parse a packed format — see src/lib/auth.ts for the actual scrypt call.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  passwordSalt String
  role         UserRole
  createdAt    DateTime @default(now())

  sessions Session[]
}

// DB-backed, not a stateless signed cookie — Next.js 16 runs proxy.ts on
// the Node.js runtime by default (confirmed against the bundled docs,
// not assumed), so a real per-request lookup here is cheap and simple,
// and — unlike a signed JWT-style cookie — lets a session be revoked
// instantly (deleting a user, or a future "log out everywhere") rather
// than only ever expiring on its own.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ScanSession {
  id        String    @id @default(uuid())
  label     String?
  startedBy String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  items Item[]
}

model Item {
  id     String     @id @default(uuid())
  sku    String     @unique @default(uuid())
  status ItemStatus @default(pending_review)

  // Scan step
  upc            String? // null for bundles — no single UPC applies
  quantity       Int // for bundles: how many complete bundles are available
  isMultipack    Boolean   @default(false)
  packSize       Int?
  expirationDate DateTime?
  shelfLocation  String
  photoUrls      String[]  @default([]) // photoUrls[0] is the bundle's "everything together" hero photo when isBundle
  scannedBy      String?

  // Bundle mode — eBay doesn't allow "mystery box" listings, so every item
  // inside a bundle has to be individually disclosed. Each entry:
  // { upc, quantity (per bundle), photoUrl, name, upcLookupData }.
  isBundle         Boolean @default(false)
  bundleComponents Json?

  scanSession   ScanSession? @relation(fields: [scanSessionId], references: [id])
  scanSessionId String?

  // Review step
  upcLookupData    Json?
  aiTitle          String?
  aiDescription    String?
  finalTitle       String?
  finalDescription String?
  price            Decimal?       @db.Decimal(10, 2)
  categoryId       String?
  condition        ItemCondition?
  compNotes        String?
  reviewedBy       String?
  reviewedAt       DateTime?
  itemSpecifics    Json? // AI-suggested key/value pairs: Color, Size, Brand, etc.

  // Shipping. Unchecked = free flat-rate shipping. Checked = calculated
  // (USPS Ground Advantage), cost varies by buyer location based on
  // weight + box size. Alaska/Hawaii are always excluded (store policy).
  chargeForShipping Boolean @default(false)
  boxSize           String?
  weightLbs         Int?
  weightOz          Int?

  // Export step
  exportBatch   ExportBatch? @relation(fields: [exportBatchId], references: [id])
  exportBatchId String?
  exportedAt    DateTime?

  // Manifest reconciliation — which shipment/load this was scanned in
  // from, if any (null for items scanned outside manifest mode).
  manifest   Manifest? @relation(fields: [manifestId], references: [id])
  manifestId String?

  // eBay API publish result — set by POST /api/items/[id]/publish-to-ebay,
  // never by the client. ebayOfferId is persisted as soon as createOffer
  // succeeds (before publishOffer runs) so a retry after a publish failure
  // can skip straight to publishing the existing offer instead of trying to
  // create a second one for the same SKU, which eBay rejects.
  ebayOfferId      String?
  ebayListingId    String?
  ebayPublishedAt  DateTime?
  ebayPublishError String?
  // "sandbox" | "production" this item was actually published to — kept
  // per-item so a listing link still resolves correctly even if EBAY_ENV
  // is later flipped to the other environment.
  ebayEnvironment  String?

  // Persisted eBay Inventory API SKU (toEbaySku(sku)), set once alongside
  // ebayOfferId. toEbaySku() is lossy/non-reversible (strips punctuation,
  // can truncate), so an incoming order's line-item SKU has to match
  // against this stored value via an indexed exact lookup rather than get
  // reverse-engineered or recomputed-and-compared against every Item.
  ebaySku String? @unique

  // Cumulative units sold via matched eBay orders and their accumulated
  // revenue/fees — updated transactionally alongside each new EbayItemSale
  // row, not recomputed by summing on every read. status only flips to
  // "sold" once soldQuantity reaches quantity (the item's full listed
  // amount); a partially-sold multi-unit item stays "listed" with
  // soldQuantity > 0, which is why these are separate fields rather than a
  // single before/after status flag.
  soldQuantity      Int     @default(0)
  soldRevenueTotal  Decimal @default(0) @db.Decimal(10, 2)
  soldFeesTotal     Decimal @default(0) @db.Decimal(10, 2)
  // Shipping label cost — a separate Finances API transaction per order
  // (transactionType SHIPPING_LABEL), not nested under a line item like
  // marketplaceFees is. Allocated across an order's matched line items
  // proportional to each line's share of the order's total value.
  soldShippingTotal Decimal @default(0) @db.Decimal(10, 2)
  // Buyer refunds against this item's sales — see EbayItemRefund. Netted
  // against revenue in profit calculations so a returned order doesn't
  // silently keep looking like a normal sale.
  refundedTotal     Decimal @default(0) @db.Decimal(10, 2)

  sales EbayItemSale[]
  stockAdjustments StockAdjustment[]

  // eBay Promoted Listings ad state — set by /api/items/[id]/promote,
  // never by the client. One campaign is shared across every item in an
  // environment (see scripts/ebay-setup-campaign.ts and the
  // *_AD_CAMPAIGN_ID env vars), so no per-item campaign id is stored here.
  ebayAdId              String?
  promotedBidPercentage Int?
  promotedAt            DateTime?
  ebayPromoteError      String?

  // eBay "Sale event" (Discounts Manager / Markdown Manager) state — set by
  // /api/items/[id]/markdown, never by the client. Shows a strikethrough
  // "was $X" price next to the discounted price on the live listing, unlike
  // the plain discount route which just silently changes the price.
  // ebayMarkdownId is the full "{promotionId}@{marketplace}" composite eBay
  // itself uses to address the promotion (see getItemPriceMarkdownPromotion).
  ebayMarkdownId        String?
  markdownPercentOff    Int?
  markdownStartedAt     DateTime?
  markdownEndsAt        DateTime?
  ebayMarkdownError     String?

  // Daily expiration sweep (src/lib/expireListings.ts / the
  // /api/cron/expire-listings cron) state. expiredAt is only set once the
  // eBay-side end call actually succeeded (status flips to "expired" at
  // the same time) — see Item.status's own comment for why this ordering
  // matters. ebayEndError is best-effort: set on a failed end-attempt so
  // it's visible and gets retried next run, cleared back to null on
  // success. shelfPullAcknowledged* records who physically pulled the
  // item off the shelf and when — free-text username, matching the exact
  // convention already used by StockAdjustment.recordedBy and
  // ManifestWalkupSale.recordedBy elsewhere in this schema, not a User FK.
  expiredAt               DateTime?
  ebayEndError            String?
  shelfPullAcknowledgedAt DateTime?
  shelfPullAcknowledgedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scanSessionId])
  @@index([manifestId])
}

// One row per matched eBay order line item — not folded into Item directly
// because one Item (quantity > 1) can sell out across several separate
// orders over time. ebayOrderLineItemId is the sync job's idempotency
// checkpoint: a repeated cron run skips any line item already recorded
// here, the same non-clobbering philosophy as Item.ebayOfferId.
model EbayItemSale {
  id                    String   @id @default(uuid())
  item                  Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId                String
  ebayOrderId           String
  ebayOrderLineItemId   String   @unique
  quantity              Int
  revenue               Decimal  @db.Decimal(10, 2) // buyer-paid total for this line item
  fees                  Decimal  @db.Decimal(10, 2) // summed marketplaceFees from the Finances API (final value fee etc.), line-item-scoped
  // Shipping label cost is a separate order-level Finances API transaction
  // (transactionType SHIPPING_LABEL), not itemized per line item — this is
  // this sale's allocated share, proportional to its revenue share of the
  // order's total value. shippingTransactionId is the real eBay
  // transaction's own id, kept so the sync job can dedupe: the SAME
  // shipping-label transaction can come back for SEVERAL different orders
  // when Cristian combine-ships them under one physical label, so its cost
  // must only ever be allocated once across whichever order claims it
  // first — checked via "does any existing sale already reference this
  // transactionId" before allocating a new one.
  shipping              Decimal  @default(0) @db.Decimal(10, 2)
  shippingTransactionId String?
  soldAt                DateTime
  createdAt             DateTime @default(now())

  refunds EbayItemRefund[]

  @@index([itemId])
  @@index([shippingTransactionId])
}

// Incremental order-sync watermark, one row per environment (mirrors
// EbayAuthToken's per-environment keying — kept separate since it's sync
// bookkeeping, not auth state).
model EbaySyncState {
  environment     String    @id // "sandbox" | "production"
  lastOrderSyncAt DateTime?
  updatedAt       DateTime  @updatedAt
}

// A buyer refund on an already-recorded sale — never folded into
// EbayItemSale directly, since one sale can be partially refunded, or
// refunded some time after the original sync already ran (eBay bumps the
// order's lastmodifieddate when a refund posts, so the regular incremental
// sync re-scans the order and finds it). ebayRefundTransactionId is the
// sync job's idempotency checkpoint, same role ebayOrderLineItemId plays
// on EbayItemSale. Only ever created against a sale that's already in our
// own data — a refund on a listing never made through this app has no
// EbayItemSale to attach to and is correctly never seen at all.
model EbayItemRefund {
  id                      String       @id @default(uuid())
  sale                    EbayItemSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId                  String
  ebayRefundTransactionId String       @unique
  amount                  Decimal      @db.Decimal(10, 2) // revenue credited back to the buyer
  feeCredit               Decimal      @default(0) @db.Decimal(10, 2) // marketplace fees eBay credited back on the refund
  refundedAt              DateTime
  createdAt               DateTime     @default(now())

  @@index([saleId])
}

// Cached app-level access token for the Browse API's Client Credentials
// grant (price research) — a completely separate OAuth flow from
// EbayAuthToken's user tokens: no refresh token, no user consent, just an
// app-identity token re-requested whenever it's near expiry. Kept in the
// DB (not an in-memory cache) so it survives serverless cold starts.
model EbayAppToken {
  environment String   @id // "sandbox" | "production"
  accessToken String
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

model ExportBatch {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  exportedBy String?

  items Item[]
}

// Keyword -> eBay category ID, so a category only has to be looked up once
// per product type. Matched against an item's title as a case-insensitive
// substring on the review page.
model CategoryRule {
  id           String   @id @default(uuid())
  keyword      String   @unique
  categoryId   String
  categoryName String
  createdAt    DateTime @default(now())
}

// eBay's full category tree, imported from their own official category
// changes export (not scraped, not AI-guessed). Used for instant local
// category search before ever falling back to an AI web search.
model EbayCategory {
  id   String @id // eBay's own category ID, used as-is
  name String // leaf category name, e.g. "Stickers"
  path String // full breadcrumb, e.g. "Crafts > ... > Stickers"

  @@index([name])
}

// Managed list of box sizes, editable on the Settings page, shown as a
// dropdown on the review page instead of free text.
model BoxSize {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now())
}

// Managed list of shelf locations, editable on the Settings page, shown as
// a dropdown on the scan page instead of free text.
model ShelfLocation {
  id        String   @id @default(uuid())
  label     String   @unique
  createdAt DateTime @default(now())
}

enum ManifestSupplier {
  bstock
  liquidation_com
  unknown
}

// One uploaded shipment/load manifest — the source of truth for what was
// supposed to arrive, so scanning against it can show what's actually been
// accounted for vs. expected. Items scanned in manifest mode still go
// through the normal review queue exactly like any other item; the
// manifest link is purely for reconciliation.
model Manifest {
  id              String           @id @default(uuid())
  title           String
  supplier        ManifestSupplier @default(unknown)
  totalLandedCost Decimal?         @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  createdBy       String?
  // false = uploaded via the Analyzer (a candidate being evaluated before
  // buying — not shown in the real Manifests list, nothing gets scanned
  // into it). true = a real, bought load — the normal receiving/
  // reconciliation flow. Defaults true so existing rows (all real,
  // predating this field) come along unaffected; the Analyzer's upload
  // route is the only caller that ever passes false. Flips true via
  // "Mark as purchased" once a candidate is actually bought — same record,
  // no data migration, so its sourcing prediction stays attached for
  // later predicted-vs-actual comparison.
  purchased       Boolean          @default(true)

  lines   ManifestLine[]
  damaged ManifestDamagedEntry[]
  duds    ManifestDudEntry[]
  items   Item[]

  sourcingEvaluations SourcingEvaluation[]
  walkupSales         ManifestWalkupSale[]
}

// One pre-purchase sourcing-agent run against a manifest's lines — created
// by POST /api/manifests/[id]/sourcing-evaluate, the actual work runs in
// after() (same fire-and-forget pattern as AI item drafting), so status
// starts "running" and the manifest detail page polls until it flips to
// "complete"/"failed". Re-running keeps prior rows (history) rather than
// overwriting, so once a manifest sells through, predicted vs. actual is
// still there to compare.
model SourcingEvaluation {
  id             String    @id @default(uuid())
  manifest       Manifest  @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId     String
  status         String // "running" | "complete" | "failed"
  recommendation String? // "buy" | "dont_buy"
  maxBid         Decimal?  @db.Decimal(10, 2)
  // Total expected revenue across the manifest minus fees/shipping, BEFORE
  // subtracting the bid itself (that's what maxBid solves against — see
  // evaluateManifest). Persisted so the UI can show expected profit
  // (this minus maxBid) and ROI at the recommended bid, not just the bid
  // number alone.
  expectedNetContribution Decimal? @db.Decimal(10, 2)
  // The two non-price reasons the code-computed recommendation can land on
  // "dont_buy" (see evaluateManifest) — persisted so the bid calculator can
  // tell "the price was too high" apart from "this manifest just isn't
  // good, no price fixes it" when Cristian tries a hypothetical bid. Null
  // while status is "running"/"failed", same as maxBid.
  dudShare         Float?
  concentrationRisk Boolean?
  reasoning      String? // plain-language explanation, written last from already-computed numbers
  error          String?
  // Live progress while status is "running" — totalSteps is set once, right
  // before per-line research starts, to (unique UPC groups + 1 for the
  // final reasoning call), so the bar reflects real work done rather than
  // a guess. Both stay at their last value once status flips to
  // "complete"/"failed", just no longer polled.
  processedSteps Int       @default(0)
  totalSteps     Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  // Large manifests (1000+ unique UPCs) can't finish inside one serverless
  // invocation's maxDuration — confirmed live on a 1036-group manifest that
  // got silently killed mid-run with no error, leaving status stuck on
  // "running" forever. The evaluation is now chunked: each invocation works
  // until it's close to its own time limit, persists what it finished (see
  // SourcingLineEstimate.groupKey), then triggers a fresh invocation to pick
  // up where it left off (src/app/api/manifests/[id]/sourcing-evaluate/
  // route.ts). These settings are snapshotted once at evaluation start and
  // reused by every chunk so a line processed in chunk 1 is judged against
  // the same inventory/margin/saturation numbers as one processed in chunk 5
  // — without this, live account state drifting mid-evaluation (a sale
  // landing between chunks, say) could make the same manifest's dud-flagging
  // inconsistent across its own lines.
  targetMarginPct            Float?
  receiveRate                Float?
  // Infinity isn't a safe round-trip value through Prisma's Postgres Float
  // mapping, so the "essentially uncapped" case (see saturationThreshold in
  // sourcingAgent.ts) is encoded as this large-but-finite sentinel instead —
  // no real activeCompCount will ever approach it.
  compSaturationThreshold    Float?
  inventoryWeeksOnHand       Float?
  inventoryActiveListedUnits Int?
  inventoryRecentSoldPerWeek Float?
  // How many months of expected inventory at a line's recent sell rate
  // counts as "too slow" (see MAX_MONTHS_TO_SELL_THROUGH_KEY / the
  // slowMover flag on SourcingLineEstimate) — a Cristian-tunable setting
  // (Settings page), snapshotted here for the same cross-chunk consistency
  // reason as the settings above.
  maxMonthsToSellThrough     Float?
  // Soft per-evaluation cap on live web-search event-status checks (see
  // MAX_EVENT_CHECKS) — tracked across chunks so a manifest heavy on
  // occasion-tied merch can't re-earn a fresh budget on every continuation.
  eventChecksUsed   Int @default(0)
  // Safety cap on how many times this evaluation has re-triggered itself —
  // stops a pathological manifest (or a genuine bug) from continuing forever
  // instead of eventually failing loudly.
  continuationCount Int @default(0)

  lineEstimates SourcingLineEstimate[]

  @@index([manifestId])
}

// One row per unique UPC actually researched — manifest lines sharing a UPC
// collapse to a single estimate (see src/lib/sourcingAgent.ts). Kept after
// the evaluation completes both for the per-line breakdown UI and as the
// prediction record the learning loop later compares against real
// outcomes.
model SourcingLineEstimate {
  id                     String             @id @default(uuid())
  evaluation             SourcingEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluationId           String
  // Internal dedup/resume key — the same upc-or-synthetic key
  // evaluateManifestChunk groups manifest lines by (upc, or
  // `__no_upc_<lineId>` for lines with no UPC, which upc alone can't
  // distinguish between each other). A chunk queries which groupKeys
  // already have a row here to know what's left to do after a restart.
  // Nullable only because 7,800+ rows already existed the day this was
  // added, from evaluations that will never resume — every row a chunk
  // creates from here on always sets a real value.
  groupKey               String?
  upc                    String?
  description            String
  extendedRetail         Decimal            @db.Decimal(10, 2)
  estimatedUnitSalePrice Decimal?           @db.Decimal(10, 2)
  estimatedUnitFees      Decimal?           @db.Decimal(10, 2)
  estimatedUnitShipping  Decimal?           @db.Decimal(10, 2)
  estimatedNetPerUnit    Decimal?           @db.Decimal(10, 2)
  effectiveUnits         Int // expected units after the supplier's real historical receive-rate haircut
  // What this UPC is realistically listed/sold as (1 = single unit, 3 = a
  // "3-Pack", etc.) — estimatedUnitSalePrice/Fees/Shipping are already
  // normalized to a true per-physical-unit basis using this, kept here so
  // the UI can show it (a real bug this caught live: sunscreen priced as
  // a 3-pack was read as $29.77 PER BOTTLE, tripling the estimate).
  typicalPackSize        Int                @default(1)
  dataConfidence         String // "own_history" | "historical_match" | "category_fallback" | "market_only"
  flaggedDud             Boolean            @default(false)
  // Carried alongside the line so a later chunk's finalization step (the
  // writeReasoning call) can reconstruct the full picture from the DB alone
  // — it may run in a different invocation than the one that computed any
  // given line.
  marketCheckFailed      Boolean            @default(false)
  marketTrend            String?
  eventEnded             Boolean            @default(false)
  postHolidayFiller      Boolean            @default(false)
  trendNudge             String?
  seasonal               String?
  // Recent real sell-through rate (own UPC if it has any recent history,
  // else its category as a proxy — see VELOCITY_LOOKBACK_DAYS in
  // sourcingAgent.ts) says the expected quantity would take longer than
  // SourcingEvaluation.maxMonthsToSellThrough to clear — a good per-unit
  // price doesn't mean much if 300 units only move 1/month. Null when
  // there's no real sales history (own or category) to judge a rate from
  // at all, same "don't flag on missing data" reasoning as marketCheckFailed
  // above. Also sets flaggedDud when true, same treatment as any other dud
  // reason. Capped at a large sentinel (not Infinity — same Postgres Float
  // round-trip reasoning as compSaturationThreshold on SourcingEvaluation)
  // when the recent rate is exactly zero despite having real history.
  slowMover              Boolean            @default(false)
  monthsToSellThrough    Float?

  @@unique([evaluationId, groupKey])
}

// Persistent, evolving judgment the agent accumulates over time — read into
// every evaluation's reasoning prompt, updated by a periodic learning pass
// (see updateSourcingKnowledge in src/lib/sourcingAgent.ts), never
// recomputed from scratch per manifest.
model SourcingKnowledge {
  id        String   @id @default(uuid())
  scope     String   @unique // "supplier:bstock" | "category:Health & Beauty" | "brand:pringles" | "global"
  notes     String
  updatedAt DateTime @updatedAt
}

// A broader, standalone snapshot of real past eBay sales, pulled directly
// from eBay's own order history (not this app's own EbayItemSale table) —
// most of a year's real sales predate this app's tracking entirely, or
// were never scanned/listed through it at all, so there's nothing to find
// here on the dashboard/manifest pages, deliberately. Used ONLY as a wider
// reference for the sourcing agent ("have we sold this brand before, at
// what price, with what shipping cost") via loose title-text matching,
// since most of these sales have no UPC linkage back to a specific
// manifest line the way this app's own tracked sales do. Includes
// everything on the account, including a VA's separate dropshipping sales
// (no reliable way to tell those apart from real liquidation resale sales
// — accepted as noise per Cristian's own call, not a bug).
model HistoricalSaleRecord {
  id                  String   @id @default(uuid())
  ebayOrderId         String
  ebayOrderLineItemId String   @unique
  title               String
  quantity            Int
  soldPrice           Decimal  @db.Decimal(10, 2) // this line's full revenue (price × quantity), same convention as EbayItemSale.revenue
  shippingCost        Decimal  @default(0) @db.Decimal(10, 2)
  fees                Decimal  @default(0) @db.Decimal(10, 2)
  soldAt              DateTime
  importedAt          DateTime @default(now())

  @@index([title])
}

// A real, timestamped measurement of eBay's live active-listing market for
// one UPC — every row is an actual snapshot taken at evaluation time (see
// estimateLine in src/lib/sourcingAgent.ts), never overwritten, so the
// table grows into a genuine time series per product instead of a single
// "current price" cache. Serves two purposes at once: (1) a fresh-enough
// snapshot (see MARKET_SNAPSHOT_FRESHNESS_HOURS) is reused instead of
// re-querying eBay's Browse API, which is what was actually burning
// through the daily rate limit — the same UPC was getting re-searched from
// scratch on every single evaluation, even re-running the same manifest
// minutes apart; (2) comparing a fresh live check against the most recent
// PRIOR snapshot for the same UPC gives a real measured price/listing-
// volume trend ("up 18% since we last checked 5 days ago") to feed the
// agent's reasoning — a much more reliable signal than the existing
// web-search-based trend nudge, since it's our own repeated measurement of
// the same query rather than an LLM's read of news/social chatter.
model MarketCompSnapshot {
  id              String   @id @default(uuid())
  upc             String
  activeCompCount Int
  medianPrice     Decimal? @db.Decimal(10, 2) // null when activeCompCount is 0 — nothing to take a median of
  capturedAt      DateTime @default(now())

  @@index([upc, capturedAt])
}

// Minimal key/value settings store — first use is the sourcing agent's
// target profit margin, reusable for any future single-value setting
// without new scaffolding.
model AppSetting {
  key   String @id
  value String
}

// One expected line from the manifest CSV — what the supplier says should
// have arrived. retailPrice/extendedRetail come straight from the CSV
// (not recomputed), so they double as a checksum against the file itself.
model ManifestLine {
  id               String   @id @default(uuid())
  manifest         Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId       String
  supplierSku      String? // e.g. BStock's "Item #" — Liquidation.com has none
  upc              String?
  description      String
  expectedQuantity Int
  retailPrice      Decimal  @db.Decimal(10, 2)
  extendedRetail   Decimal  @db.Decimal(10, 2)
  condition        String? // e.g. BStock's USED_GOOD/LIKE_NEW — Liquidation.com has none
  category         String?
  subcategory      String?
  // Original row order in the CSV — when the same UPC appears on more than
  // one line (e.g. split across pallets/lots), received/damaged units are
  // allocated to lines in this order, filling one before spilling to the
  // next, rather than crediting the same total to every matching line.
  sortOrder        Int      @default(0)

  @@index([manifestId, upc])
}

// A tally of units found damaged/expired while sorting a manifest — not a
// listing, just a count against the manifest's reconciliation, recorded via
// the "Scan as Damaged/Expired" flow instead of the normal item flow.
model ManifestDamagedEntry {
  id         String   @id @default(uuid())
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId String
  upc        String
  quantity   Int
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([manifestId, upc])
}

// Physically arrived in good condition — not damaged, not expired — but
// won't be listed on eBay at all (dead licensed/seasonal merch, a UPC with
// no realistic resale value, etc.). Same shape and same reconciliation role
// as ManifestDamagedEntry (counts toward accountedUnits so it isn't
// wrongly reported "missing"), recorded via its own "Scan as Dud/
// Unsellable" flow so the received-units figure stays a true reflection of
// what actually got reviewed and listed. Distinct from
// SourcingLineEstimate.flaggedDud, which is a pre-purchase *prediction*
// made before the manifest was ever bought — this is the real, physical
// post-purchase tally of what turned out not to be worth listing.
model ManifestDudEntry {
  id         String   @id @default(uuid())
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId String
  upc        String
  quantity   Int
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([manifestId, upc])
}

// An in-person, cash, no-fee/no-shipping sale — an employee or customer
// buying an item straight out of a manifest before it's ever listed (garage
// sale walk-ups). Same tally shape as ManifestDamagedEntry/ManifestDudEntry
// plus the real negotiated price, so it can fold into the exact same
// receivedByUpc/soldByUpc/soldRevenueByUpc accounting the manifest detail
// route already does for eBay sales — a walk-up sale is just as real for
// profit purposes, it just skipped the normal scan-in step (see
// GET /api/manifests/[id] for where this gets folded in).
model ManifestWalkupSale {
  id           String   @id @default(uuid())
  manifest     Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId   String
  upc          String
  quantity     Int
  pricePerUnit Decimal  @db.Decimal(10, 2)
  note         String?
  recordedBy   String?
  createdAt    DateTime @default(now())

  @@index([manifestId, upc])
}

// A manual add/remove stock adjustment on the Inventory page — every one
// requires a note (Cristian's explicit instruction: any manual stock
// change needs a reason on record, not just a bare number change). delta
// is signed (positive = added, negative = removed); previousAvailable/
// newAvailable are captured at write time from the freshest available
// number the server had right then (a live eBay check when possible — see
// the quantity route), not whatever was on screen when the edit started,
// so this doubles as the actual record of what was true at the moment of
// the change, not just an audit note. recordedBy is free-text for now
// (matches ManifestDudEntry/ManifestDamagedEntry's existing convention) —
// ready to become a real user reference once accounts exist.
model StockAdjustment {
  id                String   @id @default(uuid())
  item              Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId            String
  delta             Int
  previousAvailable Int
  newAvailable      Int
  note              String
  recordedBy        String?
  createdAt         DateTime @default(now())

  @@index([itemId, createdAt])
}

// eBay OAuth user token, one row per environment (sandbox/production) —
// single-tenant app, one eBay seller account, so environment alone is
// enough to key it. Keeping sandbox and production as separate rows lets
// EBAY_ENV flip between them without losing either connection. Refresh
// tokens are long-lived (~18mo) and aren't rotated on refresh, so only
// accessToken/accessTokenExpiresAt change after the initial connect.
model EbayAuthToken {
  environment           String   @id // "sandbox" | "production"
  accessToken           String
  accessTokenExpiresAt  DateTime
  refreshToken          String
  refreshTokenExpiresAt DateTime
  // Space-delimited scopes actually granted, as returned by eBay's token
  // endpoint. Null on a row issued before this field existed — treated as
  // "sell.inventory only" (its original grant) by getValidAccessToken's
  // refresh, and as "missing every newer scope" by getMissingScopes, which
  // is exactly correct: that row needs reconnecting before order sync
  // works.
  scope                 String?
  updatedAt             DateTime @updatedAt
}
